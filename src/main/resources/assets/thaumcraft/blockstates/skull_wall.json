{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "thaumcraft:block/skull_wall_post" } },
    { "when": { "facing": "east" },  "apply": { "model": "thaumcraft:block/skull_wall_post", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "thaumcraft:block/skull_wall_post", "y": 180 } },
    { "when": { "facing": "west" },  "apply": { "model": "thaumcraft:block/skull_wall_post", "y": 270 } },

    { "when": { "north": "low" },  "apply": { "model": "thaumcraft:block/skull_wall_side", "uvlock": true } },
    { "when": { "north": "tall" }, "apply": { "model": "thaumcraft:block/skull_wall_side", "uvlock": true } },
    { "when": { "east": "low" },   "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 90, "uvlock": true } },
    { "when": { "east": "tall" },  "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 90, "uvlock": true } },
    { "when": { "south": "low" },  "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 180, "uvlock": true } },
    { "when": { "south": "tall" }, "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 180, "uvlock": true } },
    { "when": { "west": "low" },   "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 270, "uvlock": true } },
    { "when": { "west": "tall" },  "apply": { "model": "thaumcraft:block/skull_wall_side", "y": 270, "uvlock": true } }
  ]
}
