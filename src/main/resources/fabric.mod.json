{
  "schemaVersion": 1,
  "id": "thaumcraft",
  "version": "${version}",
  "name": "Codex Arcanum",
  "description": "Oito mods de magia da 1.7.10 num só, trazidos para o Minecraft de hoje: o Thaumcraft 4.2.3.5 de Azanor e os cinco complementos dele, o Witchery (Ars Occulta), o Ars Magica 2 (Ars Arcana) e o Dimensional Doors (Reinos Fragmentados).",
  "authors": [
    "Tainan Fermino Peres"
  ],
  "contributors": [
    "Azanor (Thaumcraft 4)",
    "Emoniph (Witchery)",
    "Mithion (Ars Magica 2)",
    "StevenRS11 (Dimensional Doors)",
    "elenterius (Magia Naturalis)",
    "SpitefulFox (Forbidden Magic)"
  ],
  "contact": {
    "sources": "https://github.com/FP-Tainan/Thaumcraft"
  },
  "icon": "assets/thaumcraft/icon.png",
  "license": "All rights reserved to the original authors",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.thaumcraft.Thaumcraft"
    ],
    "client": [
      "net.thaumcraft.client.ThaumcraftClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "mixins": [
    "thaumcraft.mixins.json"
  ]
}
